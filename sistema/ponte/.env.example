# Ponte de impressão — copie pra .env e preencha. Roda na padaria.
# node --env-file=.env imprimir.mjs   (não precisa de npm install: usa só o Node)

# Painel (onde a ponte puxa os pedidos aprovados, por HTTPS)
API_URL=https://painel.docepao.com.br
# Token secreto — o MESMO que está no PONTE_TOKEN do painel.
PONTE_TOKEN=troque-por-um-token-secreto-da-ponte

# Impressora térmica na rede local (PCFort E200M no caixa)
# Descubra o IP dela no roteador. Porta 9100 é o padrão de impressão em rede.
IMPRESSORA_HOST=192.168.0.50
IMPRESSORA_PORTA=9100

# De quanto em quanto tempo checa por pedidos novos (ms)
INTERVALO_MS=4000

# MODO_TESTE=1 imprime no console em vez da impressora (pra testar sem papel)
MODO_TESTE=0
